@model RaceDay.Web.ViewModels.EventDetailViewModel
@inject RaceDay.Web.Services.IUserSessionService SessionService
@{
    ViewData["Title"] = Model.Event.EventName;
}

<div class="mb-4">
    <a asp-controller="Events" asp-action="Index" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Events
    </a>
</div>

<div class="card rd-card shadow-sm mb-4 overflow-hidden">
    @* Event Banner from Azure Blob Storage *@
    @if (!string.IsNullOrEmpty(Model.Event.BannerImageUrl))
    {
        <div class="position-relative">
            <img src="@Model.Event.BannerImageUrl" alt="@Model.Event.EventName" style="width: 100%; max-height: 380px; object-fit: cover;" />
            <div class="position-absolute bottom-0 start-0 w-100 p-4" style="background: linear-gradient(to top, rgba(15, 23, 42, 0.9), transparent);">
                <span class="badge bg-warning text-dark text-uppercase px-3 py-2 mb-2 fw-bold">
                    @Model.Event.EventType
                </span>
                <h1 class="display-5 fw-bold text-white mb-0">@Model.Event.EventName</h1>
            </div>
        </div>
    }
    else
    {
        <div class="p-4 bg-dark text-white">
            <span class="badge bg-warning text-dark text-uppercase px-3 py-2 mb-2 fw-bold">
                @Model.Event.EventType
            </span>
            <h1 class="display-5 fw-bold text-white mb-0">@Model.Event.EventName</h1>
        </div>
    }

    <div class="card-body p-4 p-md-5">
        <div class="row g-4 mb-4 pb-4 border-bottom">
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-warning bg-opacity-10 text-warning fs-4">
                        <i class="bi bi-calendar3"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-semibold">Event Date</small>
                        <span class="fw-bold fs-6">@Model.Event.FormattedDate</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-danger bg-opacity-10 text-danger fs-4">
                        <i class="bi bi-geo-alt-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-semibold">Location / Venue</small>
                        <span class="fw-bold fs-6">@Model.Event.Location</span>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary bg-opacity-10 text-primary fs-4">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <small class="text-muted d-block text-uppercase fw-semibold">Organised By</small>
                        <span class="fw-bold fs-6">@(string.IsNullOrEmpty(Model.Event.OrganiserName) ? "Official Organiser" : Model.Event.OrganiserName)</span>
                    </div>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.Event.Description))
        {
            <div class="mb-5">
                <h4 class="fw-bold mb-3"><i class="bi bi-info-circle text-warning me-2"></i>About This Race</h4>
                <p class="lead fs-6 text-muted" style="white-space: pre-line;">@Model.Event.Description</p>
            </div>
        }

        @* Available Categories & Enrolment *@
        <div>
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h3 class="fw-bold mb-1"><i class="bi bi-tags-fill text-warning me-2"></i>Race Categories &amp; Enrolment</h3>
                    <p class="text-muted small mb-0">Select your preferred distance category to enrol immediately</p>
                </div>
                @if (SessionService.IsOrganiser && SessionService.UserId == Model.Event.OrganiserId)
                {
                    <a asp-controller="Organiser" asp-action="Categories" asp-route-eventId="@Model.Event.EventId" class="btn btn-outline-raceday btn-sm">
                        <i class="bi bi-gear-fill me-1"></i> Manage Categories
                    </a>
                }
            </div>

            @if (Model.IsUserEnrolled)
            {
                <div class="alert alert-success d-flex align-items-center gap-3 mb-4 shadow-sm" role="alert">
                    <i class="bi bi-check-circle-fill fs-3 text-success"></i>
                    <div>
                        <h6 class="fw-bold mb-0">You are enrolled in this event!</h6>
                        <span class="small">Status: <strong class="badge bg-success">@Model.UserEnrolmentStatus</strong> — You can view your entry on the <a asp-controller="Participant" asp-action="MyEnrolments" class="alert-link">My Enrolments</a> page.</span>
                    </div>
                </div>
            }

            @if (Model.Event.Categories.Any())
            {
                <div class="row g-3">
                    @foreach (var cat in Model.Event.Categories)
                    {
                        var isThisCategoryEnrolled = Model.IsUserEnrolled && Model.EnrolledCategoryId == cat.CategoryId;

                        <div class="col-md-6 col-lg-4">
                            <div class="card rd-card h-100 p-3 @(isThisCategoryEnrolled ? "border-success border-2 bg-light" : "")">
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <h5 class="fw-bold mb-0 text-dark">@cat.CategoryName</h5>
                                    <span class="badge bg-primary fs-6">@cat.DistanceKM km</span>
                                </div>

                                <div class="my-3">
                                    <div class="display-6 fw-bold text-dark">
                                        R @cat.EntryFee.ToString("N2")
                                    </div>
                                    <small class="text-muted">Standard entry fee</small>
                                </div>

                                <div class="small text-muted mb-3 d-flex justify-content-between">
                                    <span><i class="bi bi-people me-1"></i> Enrolled: <strong>@cat.EnrolmentsCount</strong></span>
                                    <span><i class="bi bi-ticket me-1"></i> Capacity: <strong>@cat.MaxParticipants</strong></span>
                                </div>

                                <div class="mt-auto">
                                    @if (isThisCategoryEnrolled)
                                    {
                                        <button class="btn btn-success w-100" disabled>
                                            <i class="bi bi-check-circle-fill me-1"></i> Enrolled
                                        </button>
                                    }
                                    else if (cat.AvailableSpots <= 0 && cat.MaxParticipants > 0)
                                    {
                                        <button class="btn btn-secondary w-100" disabled>
                                            <i class="bi bi-x-circle me-1"></i> Fully Booked
                                        </button>
                                    }
                                    else if (SessionService.IsAuthenticated)
                                    {
                                        <form asp-controller="Events" asp-action="Enrol" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="eventId" value="@Model.Event.EventId" />
                                            <input type="hidden" name="categoryId" value="@cat.CategoryId" />
                                            <button type="submit" class="btn btn-raceday w-100">
                                                <i class="bi bi-flag-fill me-1"></i> Enrol Now
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Events/Details/@Model.Event.EventId"
                                           class="btn btn-outline-raceday w-100">
                                            <i class="bi bi-box-arrow-in-right me-1"></i> Log In to Enrol
                                        </a>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="alert alert-warning">
                    <i class="bi bi-info-circle me-1"></i> No categories have been added for this race yet.
                </div>
            }
        </div>
    </div>
</div>

@model RaceDay.Web.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Log In";
}

<div class="row justify-content-center my-4">
    <div class="col-md-6 col-lg-5">
        <div class="card rd-card shadow">
            <div class="card-body p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex p-3 rounded-circle bg-warning bg-opacity-10 text-warning mb-2">
                        <i class="bi bi-stopwatch-fill fs-2"></i>
                    </div>
                    <h2 class="fw-bold mb-1">Welcome Back</h2>
                    <p class="text-muted small">Sign in to manage your events or track race registrations</p>
                </div>

                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label text-muted small"></label>
                    </div>

                    <button type="submit" class="btn btn-raceday w-100 py-2 mb-3">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Don't have an account?</span>
                        <a asp-controller="Account" asp-action="Register" class="fw-semibold text-decoration-none ms-1">
                            Register Now
                        </a>
                    </div>
                </form>

                @* Demo Credentials Card for Examiners & Testers *@
                <div class="mt-4 pt-3 border-top">
                    <small class="text-muted fw-bold text-uppercase d-block mb-2">
                        <i class="bi bi-key-fill text-warning me-1"></i> Pre-Seeded Demo Logins (Password: <code>Password123!</code>)
                    </small>
                    <div class="d-flex flex-column gap-2 small">
                        <div class="p-2 rounded bg-light border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge badge-role-organiser me-1">Organiser</span>
                                <span class="text-dark">sipho.nkosi@raceevents.co.za</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    onclick="fillLogin('sipho.nkosi@raceevents.co.za', 'Password123!')">
                                Use
                            </button>
                        </div>
                        <div class="p-2 rounded bg-light border d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge badge-role-participant me-1">Participant</span>
                                <span class="text-dark">thabo.m@gmail.com</span>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-secondary py-0 px-2"
                                    onclick="fillLogin('thabo.m@gmail.com', 'Password123!')">
                                Use
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function fillLogin(email, password) {
            document.getElementById('Email').value = email;
            document.getElementById('Password').value = password;
        }
    </script>
}

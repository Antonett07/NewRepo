@{
    ViewData["Title"] = "Access Forbidden";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 text-center">
        <div class="card rd-card p-5 shadow">
            <div class="display-1 text-danger mb-3">
                <i class="bi bi-shield-lock-fill"></i>
            </div>
            <h2 class="fw-bold mb-2">Access Denied</h2>
            <p class="text-muted mb-4">
                You do not have the required permissions or role to view this page.
                Please ensure you are signed in with the appropriate account.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-house-door me-1"></i> Return Home
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-raceday">
                    <i class="bi bi-box-arrow-in-right me-1"></i> Switch Account
                </a>
            </div>
        </div>
    </div>
</div>

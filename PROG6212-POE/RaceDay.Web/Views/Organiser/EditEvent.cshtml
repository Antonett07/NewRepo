@model RaceDay.Web.ViewModels.CreateEventViewModel
@{
    ViewData["Title"] = "Edit Event - " + Model.EventName;
}

<div class="row justify-content-center my-4">
    <div class="col-lg-8">
        <div class="card rd-card shadow">
            <div class="card-header bg-dark text-white p-4">
                <div class="d-flex align-items-center justify-content-between">
                    <div>
                        <h4 class="fw-bold mb-1"><i class="bi bi-pencil-square text-warning me-2"></i>Edit Event</h4>
                        <small class="text-white-50">Update event details and replace event banner</small>
                    </div>
                    <a asp-action="Events" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-x-lg"></i> Cancel
                    </a>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger py-2 px-3 small">
                        <i class="bi bi-exclamation-triangle-fill me-1"></i>
                        @Html.ValidationSummary(true, "")
                    </div>
                }

                <form asp-action="EditEvent" asp-route-id="@Model.EventId" method="post" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="EventId" />
                    <input type="hidden" asp-for="ExistingBannerUrl" />

                    @if (!string.IsNullOrEmpty(Model.ExistingBannerUrl))
                    {
                        <div class="mb-4">
                            <label class="form-label fw-semibold text-muted small text-uppercase">Current Banner Image</label>
                            <div>
                                <img src="@Model.ExistingBannerUrl" alt="Current Banner" class="rounded shadow-sm" style="max-height: 180px; width: 100%; object-fit: cover;" />
                            </div>
                        </div>
                    }

                    <div class="mb-3">
                        <label asp-for="EventName" class="form-label fw-semibold"></label>
                        <input asp-for="EventName" class="form-control" />
                        <span asp-validation-for="EventName" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventType" class="form-label fw-semibold"></label>
                            <select asp-for="EventType" class="form-select">
                                <option value="Road Running">Road Running</option>
                                <option value="Trail Running">Trail Running</option>
                                <option value="Cycling">Road Cycling</option>
                                <option value="Mountain Biking">Mountain Biking</option>
                                <option value="Fun Run / Walk">Fun Run / Walk</option>
                                <option value="Triathlon">Triathlon</option>
                            </select>
                            <span asp-validation-for="EventType" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Distance" class="form-label fw-semibold"></label>
                            <input asp-for="Distance" class="form-control" />
                            <span asp-validation-for="Distance" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="EventDate" class="form-label fw-semibold"></label>
                            <input asp-for="EventDate" class="form-control" type="datetime-local" />
                            <span asp-validation-for="EventDate" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Location" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-geo-alt"></i></span>
                                <input asp-for="Location" class="form-control" />
                            </div>
                            <span asp-validation-for="Location" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label fw-semibold"></label>
                        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                        <span asp-validation-for="Description" class="text-danger small"></span>
                    </div>

                    @* Azure Blob Storage Image Upload *@
                    <div class="mb-4 p-3 bg-light rounded-3 border">
                        <label asp-for="BannerImage" class="form-label fw-semibold">
                            <i class="bi bi-cloud-arrow-up-fill text-warning me-1"></i> Replace Banner Image (Azure Blob Storage)
                        </label>
                        <input asp-for="BannerImage" type="file" class="form-control" accept="image/*" />
                        <small class="text-muted d-block mt-1">
                            Upload a new image to replace the current banner in Azure Blob Storage.
                        </small>
                    </div>

                    <div class="d-flex justify-content-between align-items-center pt-2">
                        <a asp-action="Events" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i> Back to Events
                        </a>
                        <button type="submit" class="btn btn-raceday px-4">
                            <i class="bi bi-save-fill me-1"></i> Save Changes
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

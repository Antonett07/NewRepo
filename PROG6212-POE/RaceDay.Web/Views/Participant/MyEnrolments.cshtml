@model List<RaceDay.Web.ViewModels.EnrolmentViewModel>
@{
    ViewData["Title"] = "My Enrolments";
}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
    <div>
        <h2 class="fw-bold mb-1">
            <i class="bi bi-ticket-perforated text-warning me-2"></i>My Race Enrolments
        </h2>
        <p class="text-muted mb-0">Track all your registered events, bib numbers, and enrolment statuses</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="Events" asp-action="Index" class="btn btn-raceday">
            <i class="bi bi-plus-circle-fill me-1"></i> Browse More Races
        </a>
        <a asp-action="MyResults" class="btn btn-outline-raceday">
            <i class="bi bi-trophy-fill me-1"></i> My Race History
        </a>
    </div>
</div>

@if (Model.Any())
{
    <div class="row g-4">
        @foreach (var entry in Model)
        {
            <div class="col-md-6 col-lg-4">
                <div class="card rd-card h-100 d-flex flex-column">
                    @if (!string.IsNullOrEmpty(entry.BannerImageUrl))
                    {
                        <img src="@entry.BannerImageUrl" alt="@entry.EventName" class="rd-card-banner" />
                    }
                    else
                    {
                        <div class="rd-card-banner bg-secondary d-flex align-items-center justify-content-center text-white">
                            <i class="bi bi-image fs-1 text-white-50"></i>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            @* Colour-coded status badge (Requirement 7) *@
                            @if (entry.IsConfirmed)
                            {
                                <span class="status-badge status-confirmed">
                                    <i class="bi bi-check-circle-fill"></i> Confirmed
                                </span>
                            }
                            else if (entry.IsPending)
                            {
                                <span class="status-badge status-pending">
                                    <i class="bi bi-clock-fill"></i> Pending
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-cancelled">
                                    <i class="bi bi-x-circle-fill"></i> @entry.PaymentStatus
                                </span>
                            }

                            @if (entry.RaceNumber.HasValue)
                            {
                                <span class="badge bg-dark font-monospace fs-6">
                                    Bib #@entry.RaceNumber.Value
                                </span>
                            }
                        </div>

                        <h5 class="card-title fw-bold text-dark mb-1">@entry.EventName</h5>
                        <div class="text-muted small mb-2"><i class="bi bi-geo-alt-fill text-danger me-1"></i>@entry.Location</div>

                        <div class="p-3 bg-light rounded-3 my-2">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">Category:</span>
                                <span class="fw-bold small text-dark">@entry.CategoryName</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="small text-muted">Distance:</span>
                                <span class="badge bg-primary">@entry.DistanceKM km</span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center">
                                <span class="small text-muted">Entry Fee:</span>
                                <span class="fw-bold text-dark">R @entry.EntryFee.ToString("N2")</span>
                            </div>
                        </div>

                        <div class="small text-muted mb-3">
                            <i class="bi bi-calendar3 text-warning me-1"></i> Date: <strong>@entry.EventDate.ToString("dd MMM yyyy HH:mm")</strong>
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex justify-content-between align-items-center">
                            <small class="text-muted">Enrolled: @entry.EnrolmentDate.ToString("dd/MM/yyyy")</small>
                            <a asp-controller="Events" asp-action="Details" asp-route-id="@entry.EventId" class="btn btn-outline-secondary btn-sm">
                                View Event
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card rd-card p-5 text-center my-4 shadow-sm">
        <div class="display-3 text-muted mb-3"><i class="bi bi-ticket-detailed"></i></div>
        <h4 class="fw-bold mb-2">No Active Race Enrolments</h4>
        <p class="text-muted mb-4">You have not enrolled in any upcoming events yet. Choose a race and register today!</p>
        <div>
            <a asp-controller="Events" asp-action="Index" class="btn btn-raceday">
                <i class="bi bi-search me-1"></i> Discover Races
            </a>
        </div>
    </div>
}

@inject RaceDay.Web.Services.IUserSessionService SessionService
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RaceDay Platform</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RaceDay.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark rd-navbar shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-stopwatch-fill brand-highlight"></i>
                    <span>Race<span class="brand-highlight">Day</span></span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent"
                        aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house-door me-1"></i> Home
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">
                                <i class="bi bi-calendar-event me-1"></i> Upcoming Events
                            </a>
                        </li>

                        @if (SessionService.IsAuthenticated)
                        {
                            @if (SessionService.IsOrganiser)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Dashboard">
                                        <i class="bi bi-speedometer2 me-1"></i> Dashboard
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Organiser" asp-action="Events">
                                        <i class="bi bi-kanban me-1"></i> Events Management
                                    </a>
                                </li>
                            }

                            @if (SessionService.IsParticipant)
                            {
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyEnrolments">
                                        <i class="bi bi-ticket-perforated me-1"></i> My Enrolments
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link" asp-controller="Participant" asp-action="MyResults">
                                        <i class="bi bi-trophy me-1"></i> My Results
                                    </a>
                                </li>
                            }
                        }
                    </ul>

                    <ul class="navbar-nav ms-auto align-items-center">
                        @if (SessionService.IsAuthenticated)
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle d-flex align-items-center gap-2" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @if (!string.IsNullOrEmpty(SessionService.ProfilePictureUrl))
                                    {
                                        <img src="@SessionService.ProfilePictureUrl" alt="@SessionService.FullName" class="rd-avatar-sm" />
                                    }
                                    else
                                    {
                                        <i class="bi bi-person-circle fs-5"></i>
                                    }
                                    <span class="d-none d-md-inline fw-semibold text-white">@SessionService.FullName</span>
                                    @if (SessionService.IsOrganiser)
                                    {
                                        <span class="badge badge-role-organiser">Organiser</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-role-participant">Participant</span>
                                    }
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow border-0" aria-labelledby="userDropdown">
                                    <li><h6 class="dropdown-header">Signed in as @SessionService.Email</h6></li>
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="Profile">
                                            <i class="bi bi-person me-2"></i> Profile & Photo
                                        </a>
                                    </li>
                                    @if (SessionService.IsOrganiser)
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Organiser" asp-action="Dashboard">
                                                <i class="bi bi-speedometer2 me-2"></i> Organiser Dashboard
                                            </a>
                                        </li>
                                    }
                                    else
                                    {
                                        <li>
                                            <a class="dropdown-item" asp-controller="Participant" asp-action="MyEnrolments">
                                                <i class="bi bi-ticket-perforated me-2"></i> My Enrolments
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" asp-controller="Participant" asp-action="MyResults">
                                                <i class="bi bi-trophy me-2"></i> My Results
                                            </a>
                                        </li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">
                                            <i class="bi bi-box-arrow-right me-2"></i> End Session / Logout
                                        </a>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item me-2">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Log In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-raceday btn-sm" asp-controller="Account" asp-action="Register">
                                    <i class="bi bi-person-plus-fill me-1"></i> Register
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        @* Alert Messages *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2 text-success"></i>
                <div>@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2 text-danger"></i>
                <div>@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-exclamation-circle-fill fs-5 me-2 text-warning"></i>
                <div>@TempData["WarningMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["InfoMessage"] != null)
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm border-0 d-flex align-items-center" role="alert">
                <i class="bi bi-info-circle-fill fs-5 me-2 text-info"></i>
                <div>@TempData["InfoMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer>
        <div class="container text-center">
            <div class="row align-items-center">
                <div class="col-md-6 text-md-start mb-3 mb-md-0">
                    <div class="fw-bold fs-5 text-white d-flex align-items-center gap-2">
                        <i class="bi bi-stopwatch-fill text-warning"></i> RaceDay
                    </div>
                    <small class="text-secondary">Official South African Road Running, Walking & Cycling Platform.</small>
                </div>
                <div class="col-md-6 text-md-end">
                    <small>&copy; 2026 RaceDay Inc. Powered by ASP.NET Core &amp; Azure Blob Storage.</small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
